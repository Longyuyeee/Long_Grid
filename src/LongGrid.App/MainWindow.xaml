                                Message="选择场景只生成匿名差异；确认按钮仅记录理解，不执行恢复。" />

                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择匿名规划结果" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="产品必须区分可自动恢复、需要确认和禁止应用，不能把相似映射包装成已识别同一显示器。"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button
                                            x:Name="RecoveryAutomaticScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryAutomaticScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="拓扑等价：Automatic"
                                            HorizontalAlignment="Left"
                                            Tag="automatic" />
                                        <Button
                                            x:Name="RecoveryReviewScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryReviewScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="需要可见性纠正：ReviewRequired"
                                            HorizontalAlignment="Left"
                                            Tag="review" />
                                        <Button
                                            x:Name="RecoveryBlockedScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryBlockedScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="映射缺失或歧义：Blocked"
                                            HorizontalAlignment="Left"
                                            Tag="blocked" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="RecoveryPlanStatus"
                                        AutomationProperties.AutomationId="RecoveryPlanStatus"
                                        AutomationProperties.ItemStatus="RecoveryPreviewReady"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="请选择场景；尚未生成恢复差异，尚未移动任何方格。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="RecoveryDiffPanel"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="RecoveryDiffPanel"
                                AutomationProperties.Name="匿名恢复差异"
                                Style="{StaticResource LongGridCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="12">
                                    <TextBlock
                                        x:Name="RecoverySummaryTitle"
                                        AutomationProperties.AutomationId="RecoverySummaryTitle"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="RecoveryDiffDetail"
                                        AutomationProperties.AutomationId="RecoveryDiffDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="RecoverySafetyDetail"
                                        AutomationProperties.AutomationId="RecoverySafetyDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button
                                            x:Name="ReviewRecoveryButton"
                                            AutomationProperties.AutomationId="ReviewRecoveryButton"
                                            Click="ReviewRecoveryButton_Click"
                                            Content="确认理解（不执行）"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="ExpireRecoveryPreviewButton"
                                            AutomationProperties.AutomationId="ExpireRecoveryPreviewButton"
                                            Click="ExpireRecoveryPreviewButton_Click"
                                            Content="模拟显示再次变化"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="CancelRecoveryPreviewButton"
                                            AutomationProperties.AutomationId="CancelRecoveryPreviewButton"
                                            Click="CancelRecoveryPreviewButton_Click"
                                            Content="取消并保持当前布局"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="AppearancePanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="AppearancePanel"
                            AutomationProperties.Name="个性化内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <controls:ProductPageHeader
                                AutomationProperties.AutomationId="PersonalizationPageHeader"
                                Title="个性化"
                                Subtitle="调整 Long方格主题，并查看当前 Windows 的任务栏兼容状态。" />
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="界面主题" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="切换只在当前进程内生效；本切片不写配置，也不改变 Windows 系统主题。" />
                                    <StackPanel x:Name="ThemeOptions" Orientation="Horizontal" Spacing="20">
                                        <RadioButton
                                            x:Name="ThemeSystem"
                                            AutomationProperties.AutomationId="ThemeSystem"
                                            Checked="ThemeOption_Checked"
                                            Content="跟随系统"
                                            GroupName="AppTheme"
                                            IsChecked="True"
                                            Tag="system" />
                                        <RadioButton
                                            x:Name="ThemeLight"
                                            AutomationProperties.AutomationId="ThemeLight"
                                            Checked="ThemeOption_Checked"
                                            Content="浅色"
                                            GroupName="AppTheme"
                                            Tag="light" />
                                        <RadioButton
                                            x:Name="ThemeDark"
                                            AutomationProperties.AutomationId="ThemeDark"
                                            Checked="ThemeOption_Checked"
                                            Content="深色"
                                            GroupName="AppTheme"
                                            Tag="dark" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ThemeStatusText"
                                        AutomationProperties.AutomationId="ThemeStatusText"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="当前：跟随系统（本次使用）" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="任务栏" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="Long方格会检查当前 Windows 版本和其他任务栏工具，确认可以安全应用外观。检测期间现有任务栏不会改变。"
                                        TextWrapping="Wrap" />
                                    <Grid
                                        x:Name="TaskbarPresetGrid"
                                        AutomationProperties.AutomationId="TaskbarPresetGrid"
                                        AutomationProperties.Name="任务栏外观预设"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Padding="16"
                                            Background="{ThemeResource LongGridSurfaceMutedBrush}"
                                            BorderBrush="{ThemeResource LongGridBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource LongGridCornerRadiusMedium}">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="系统默认" />
                                                <TextBlock
                                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                                    Text="回到 Windows 原本的任务栏外观；需要恢复时可在这里一键完成。" />
                                                <Button
                                                    x:Name="TaskbarSystemDefaultButton"
                                                    AutomationProperties.AutomationId="TaskbarSystemDefaultButton"
                                                    AutomationProperties.Name="恢复系统默认任务栏"
                                                    Content="恢复系统默认"
                                                    HorizontalAlignment="Left"
                                                    IsEnabled="False" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Padding="16"
                                            Background="{ThemeResource LongGridSurfaceMutedBrush}"
                                            BorderBrush="{ThemeResource LongGridBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource LongGridCornerRadiusMedium}">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="通透" />
                                                <TextBlock
                                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                                    Text="提供清晰、轻盈的任务栏材质；仅在当前 Windows 版本通过兼容验证后可用。" />
                                                <Button
                                                    x:Name="TaskbarClearPresetButton"
                                                    AutomationProperties.AutomationId="TaskbarClearPresetButton"
                                                    AutomationProperties.Name="应用通透任务栏预设"
                                                    Content="应用通透"
                                                    HorizontalAlignment="Left"
                                                    IsEnabled="False" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        x:Name="TaskbarPresetAvailabilityText"
                                        AutomationProperties.AutomationId="TaskbarPresetAvailabilityText"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="正在确认两个预设是否可用。" />
                                    <InfoBar
                                        x:Name="TaskbarCompatibilityInfoBar"
                                        AutomationProperties.AutomationId="TaskbarCompatibilityInfoBar"
                                        AutomationProperties.LiveSetting="Polite"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Severity="Informational"
                                        Title="正在检测任务栏兼容性"
                                        Message="完成当前 Windows 版本的兼容与恢复验证前，任务栏预设保持关闭。" />
                                    <TextBlock
                                        x:Name="TaskbarCompatibilityDetail"
                                        AutomationProperties.AutomationId="TaskbarCompatibilityDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="正在读取当前 Windows 和任务栏状态。"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="TaskbarCompatibilityRefreshButton"
                                        AutomationProperties.AutomationId="TaskbarCompatibilityRefreshButton"
                                        AutomationProperties.Name="重新检测任务栏兼容性"
                                        Click="TaskbarCompatibilityRefreshButton_Click"
                                        Content="重新检测"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="SafetyPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="SafetyPanel"
                            AutomationProperties.Name="设置内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <controls:ProductPageHeader
                                AutomationProperties.AutomationId="SettingsPageHeader"
                                Title="设置"
                                Subtitle="管理配置、隐私与高级诊断。核心盒子设置将在盒子管理中就近完成。" />
                            <Border
                                x:Name="SettingsGeneralSection"
                                AutomationProperties.AutomationId="SettingsGeneralSection"
                                AutomationProperties.Name="常规设置"
                                Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="常规" />
                                    <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="备份、恢复或迁移你的 Long方格配置。" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="导入配置" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="选择本地 .json 配置，预览内容并确认后再恢复。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ImportConfigurationButton"
                                            AutomationProperties.AutomationId="ImportConfigurationButton"
                                            AutomationProperties.Name="选择并检查本地配置"
                                            Click="ImportConfigurationButton_Click"
                                            Content="选择配置…" />
                                        <TextBlock
                                            x:Name="ConfigurationImportStatus"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ConfigurationImportStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未选择配置。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="导出配置" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="将当前配置保存为独立备份文件；同名文件不会被覆盖。"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ExportConfigurationButton"
                                            AutomationProperties.AutomationId="ExportConfigurationButton"
                                            AutomationProperties.Name="预览并导出已验证配置"
                                            Click="ExportConfigurationButton_Click"
                                            Content="导出配置…" />
                                        <TextBlock
                                            x:Name="ConfigurationExportStatus"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ConfigurationExportStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未准备导出。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="SettingsPrivacySection"
                                AutomationProperties.AutomationId="SettingsPrivacySection"
                                AutomationProperties.Name="隐私与安全"
                                Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="隐私与安全" />
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Severity="Success"
                                        Title="你的桌面文件由你掌控"
                                        Message="Long方格保存盒子布局和文件夹引用；导入、导出和诊断都需要你主动操作。" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="配置操作不会移动或删除桌面文件。执行任何可能影响文件的动作前，软件必须显示清晰预览并再次确认。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Expander
                                x:Name="SettingsAdvancedDiagnosticsExpander"
                                AutomationProperties.AutomationId="SettingsAdvancedDiagnosticsExpander"
                                AutomationProperties.Name="高级诊断"
                                Header="高级诊断"
                                IsExpanded="False">
                                <Border Margin="0,8,0,0" Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="仅在排查问题或提供支持信息时使用。这里的功能默认关闭，不会持续记录操作。" TextWrapping="Wrap" />
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="匿名诊断快照" />
                                        <TextBlock
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="确认后保存一次当前交互状态；清单不显示文件路径，也不会持续记录。"
                                            TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="CaptureAnonymousInteractionEvidenceButton"
                                            AutomationProperties.AutomationId="CaptureAnonymousInteractionEvidenceButton"
                                            AutomationProperties.Name="确认保存当前匿名交互证据"
                                            Click="CaptureAnonymousInteractionEvidenceButton_Click"
                                            Content="保存匿名交互快照…" />
                                        <Button
                                            x:Name="RefreshConfigurationEvidenceButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="RefreshConfigurationEvidenceButton"
                                            AutomationProperties.Name="刷新证据清单"
                                            Click="RefreshConfigurationEvidenceButton_Click"
                                            Content="刷新证据" />
                                        <TextBlock
                                            x:Name="ConfigurationEvidenceStatus"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="ConfigurationEvidenceStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未读取证据元数据。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <ListView
                                        x:Name="ConfigurationEvidenceList"
                                        AutomationProperties.AutomationId="ConfigurationEvidenceList"
                                        AutomationProperties.Name="证据匿名清单"
                                        MaxHeight="220"
                                        SelectionChanged="ConfigurationEvidenceList_SelectionChanged"
                                        SelectionMode="Single" />
                                    <Button
                                        x:Name="ExportConfigurationEvidenceButton"
                                        AutomationProperties.AutomationId="ExportConfigurationEvidenceButton"
                                        AutomationProperties.Name="导出所选证据"
                                        Click="ExportConfigurationEvidenceButton_Click"
                                        Content="导出所选证据…"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                                    <Button
                                        x:Name="RemoveConfigurationEvidenceButton"
                                        AutomationProperties.AutomationId="RemoveConfigurationEvidenceButton"
                                        AutomationProperties.Name="永久清理所选证据"
                                        Click="RemoveConfigurationEvidenceButton_Click"
                                        Content="清理所选证据…"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Grid
            x:Name="DesktopWorkspaceCreateSafePreviewOverlay"
            Grid.RowSpan="2"
            Padding="24"
            Background="#99000000"
            Visibility="Collapsed"
            AutomationProperties.AccessibilityView="Content"
            AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewOverlay"
            AutomationProperties.Name="桌面新方格安全预览">
            <Border
                Width="420"
                Padding="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{ThemeResource LongGridSurfaceBrush}"
                BorderBrush="{ThemeResource LongGridBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="预览新方格" />
                    <TextBlock
                        Text="检查名称和候选位置后再创建。取消不会创建方格，也不会读取、移动或修改桌面文件。"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="DesktopWorkspaceCreateSafePreviewNameEditor"
                        Header="方格名称"
                        MaxLength="80"
                        TextChanged="DesktopWorkspaceCreateSafePreviewNameEditor_TextChanged"
                        AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewNameEditor"
                        AutomationProperties.Name="方格名称" />
                    <TextBlock
                        x:Name="DesktopWorkspaceCreateSafePreviewPlacementSummary"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewPlacementSummary" />
                    <TextBlock
                        x:Name="DesktopWorkspaceCreateSafePreviewValidation"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewValidation"
                        AutomationProperties.LiveSetting="Polite" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="取消"
                            Click="DesktopWorkspaceCreateSafePreviewCancelButton_Click"
                            AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewCancelButton" />
                        <Button
                            x:Name="DesktopWorkspaceCreateSafePreviewConfirmButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="创建并保存"
                            Click="DesktopWorkspaceCreateSafePreviewConfirmButton_Click"
                            AutomationProperties.AutomationId="DesktopWorkspaceCreateSafePreviewConfirmButton" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
