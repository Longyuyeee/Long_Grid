<Window
    x:Class="LongGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Long方格">

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource LongGridWindowBrush}"
        AutomationProperties.AccessibilityView="Content"
        AutomationProperties.AutomationId="LongGridRoot"
        AutomationProperties.ItemStatus="wide"
        AutomationProperties.Name="Long方格主界面">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="24"
                Height="24"
                Source="Assets/LongFangGe.png"
                AutomationProperties.Name="Long方格图标" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource LongGridTextPrimaryBrush}"
                Text="Long方格" />
            <Border
                x:Name="DevelopmentBadge"
                Grid.Column="2"
                Margin="14,0,0,0"
                Padding="8,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource LongGridSurfaceMutedBrush}"
                CornerRadius="8">
                <TextBlock
                    x:Name="DevelopmentBadgeText"
                    AutomationProperties.AutomationId="ResponsiveStatusText"
                    FontSize="11"
                    Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                    Text="开发期 · 只读 UI Shell" />
            </Border>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellNavigation"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="244"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AccessKey="1"
                    AutomationProperties.AutomationId="NavOverview"
                    Content="概览"
                    Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="2"
                    AutomationProperties.AutomationId="NavFirstRun"
                    Content="首次整理"
                    Tag="first-run">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="3"
                    AutomationProperties.AutomationId="NavAppearance"
                    Content="外观与 Token"
                    Tag="appearance">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="4"
                    AutomationProperties.AutomationId="NavSafety"
                    Content="安全边界"
                    Tag="safety">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="5"
                    AutomationProperties.AutomationId="NavRecovery"
                    Content="恢复预览"
                    Tag="recovery">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Refresh" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentFrame" Padding="32,28,32,32">
                <ScrollViewer
                    AutomationProperties.AutomationId="ContentScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                        <StackPanel
                            x:Name="OverviewPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="OverviewPanel"
                            AutomationProperties.Name="概览内容"
                            Spacing="20">
                            <InfoBar
                                x:Name="ConfigurationRecoveryBanner"
                                AutomationProperties.ItemStatus="StartupReadOnly:Catalog=FirstLevelMetadata;DesktopFileWrites=Disabled;DesktopHost=Disconnected"
                                IsClosable="False"
                                IsOpen="True"
                                Severity="Informational"
                                Title="正在检查本地配置"
                                Message="配置与桌面目录采用只读启动；不会移动、重命名、删除或写入桌面文件，也不连接 DesktopHost 执行窗口操作。">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Name="ConfigurationRecoveryActionButton"
                                        AutomationProperties.AutomationId="ConfigurationRecoveryActionButton"
                                        AutomationProperties.Name="检查并接受已验证备份"
                                        Click="ConfigurationRecoveryActionButton_Click"
                                        Content="检查并接受备份"
                                        Visibility="Collapsed" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="DESKTOP WORKSPACE" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="把桌面还给专注本身" />
                                <TextBlock
                                    x:Name="RuntimeScopeDisclosureText"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.ItemStatus="Catalog=RealDesktopFirstLevelMetadata;Practice=AnonymousMemory;FileContent=NotRead;DesktopFileWrites=Disabled;DesktopHost=Disconnected"
                                    AutomationProperties.Name="当前数据与执行边界"
                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                    Text="概览中的目录与正式工作区会只读枚举本机用户桌面和公共桌面第一层元数据；首次整理、拖放与恢复练习仍使用匿名内存数据。Long方格不会读取文件内容，也不会移动、重命名、删除或写入桌面文件，DesktopHost 执行保持关闭。" />
                            </StackPanel>

                            <Grid x:Name="OverviewMetricsGrid" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="CurrentModeCard"
                                    Grid.Column="0"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="CurrentModeCard"
                                    AutomationProperties.Name="当前模式"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="当前模式" />
                                        <TextBlock x:Name="CurrentModeValue" AutomationProperties.AutomationId="CurrentModeValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CurrentModeDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="FileOperationCard"
                                    Grid.Column="1"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="FileOperationCard"
                                    AutomationProperties.Name="文件操作"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="文件操作" />
                                        <TextBlock x:Name="FileOperationValue" AutomationProperties.AutomationId="FileOperationValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="FileOperationDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="DesktopHostCard"
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="DesktopHostCard"
                                    AutomationProperties.Name="桌面宿主"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="桌面宿主" />
                                        <TextBlock x:Name="DesktopHostValue" AutomationProperties.AutomationId="DesktopHostValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DesktopHostDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                        <Button
                                            x:Name="DesktopKeyboardInteractionButton"
                                            AccessKey="I"
                                            AutomationProperties.AutomationId="DesktopKeyboardInteractionButton"
                                            AutomationProperties.Name="进入桌面方格交互"
                                            Click="DesktopKeyboardInteractionButton_Click"
                                            Content="进入桌面交互 (_I)"
                                            IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                x:Name="ProductDesktopCatalogCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductDesktopCatalogCard"
                                AutomationProperties.Name="只读桌面目录状态"
                                Style="{StaticResource LongGridCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        x:Name="ProductDesktopCatalogIcon"
                                        Margin="2,2,0,0"
                                        Symbol="Folder" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogTitle"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogTitle"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="桌面目录尚未读取" />
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogDetail"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogDetail"
                                            AutomationProperties.ItemStatus="DesktopCatalogUnavailable:Generation=0:Items=0:Authoritative=False"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="只读适配器尚未发布权威快照；不会执行文件写入。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogGeneration"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogGeneration"
                                            FontSize="11"
                                            Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                            Text="刷新代次 0 · 用户桌面 未读取 · 公共桌面 未读取" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ProductDesktopCatalogRefreshButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="ProductDesktopCatalogRefreshButton"
                                        AutomationProperties.Name="刷新只读桌面目录"
                                        Click="ProductDesktopCatalogRefreshButton_Click"
                                        Content="刷新目录" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceSessionCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceSessionCard"
                                AutomationProperties.Name="正式产品工作区会话状态"
                                Style="{StaticResource LongGridCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        x:Name="ProductWorkspaceSessionIcon"
                                        Margin="2,2,0,0"
                                        Symbol="Clock" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionTitle"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionTitle"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="正在建立产品会话" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionDetail"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionDetail"
                                            AutomationProperties.ItemStatus="WorkspaceSessionLoading:Source=None:Catalog=Unavailable:ReadOnly=True"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在安全读取正式配置；不会把空目录清单冒充当前桌面状态。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionSummary"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionSummary"
                                            FontSize="11"
                                            Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                            Text="引用解析计数尚不可用" />
                                        <Button
                                            x:Name="ProductWorkspaceLatestUndoButton"
                                            AutomationProperties.AutomationId="ProductWorkspaceLatestUndoButton"
                                            AutomationProperties.ItemStatus="LatestWorkspaceEditUndo:Kind=Unavailable:CanUndo=False:DesktopFilesChanged=False:DesktopWindowsChanged=False"
                                            AutomationProperties.Name="没有可撤销的 Long方格配置编辑"
                                            Click="ProductWorkspaceLatestUndoButton_Click"
                                            Content="没有可撤销的配置编辑"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceLayoutRecoveryCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryCard"
                                AutomationProperties.Name="正式布局恢复只读预览"
                                Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoveryTitle"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="布局恢复预览尚不可用" />
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoveryDetail"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryDetail"
                                        AutomationProperties.ItemStatus="LayoutRecoveryPreviewUnavailableSession:Containers=0:Mappings=0:Unresolved=0:Corrected=0:DesktopWindowsChanged=False"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="等待正式产品会话；没有读取或移动任何桌面窗口。"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoverySummary"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoverySummary"
                                        FontSize="11"
                                        Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                        Text="容器与显示拓扑尚不可用" />
                                    <Button
                                        x:Name="ProductWorkspaceLayoutRecoveryConfirmButton"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryConfirmButton"
                                        AutomationProperties.Name="审查并确认配置级布局恢复"
                                        Click="ProductWorkspaceLayoutRecoveryConfirmButton_Click"
                                        Content="审查并确认配置恢复"
                                        IsEnabled="False"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="ProductWorkspaceLayoutRecoveryUndoButton"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryUndoButton"
                                        AutomationProperties.Name="撤销本次配置级布局恢复"
                                        Click="ProductWorkspaceLayoutRecoveryUndoButton_Click"
                                        Content="撤销本次配置恢复"
                                        IsEnabled="False"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceViewCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceViewCard"
                                AutomationProperties.Name="正式工作区只读视图"
                                Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="ProductWorkspaceViewTitle"
                                            AutomationProperties.AutomationId="ProductWorkspaceViewTitle"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="正式工作区" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceViewDetail"
                                            AutomationProperties.AutomationId="ProductWorkspaceViewDetail"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="等待正式产品会话；当前没有展示或修改任何桌面内容。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="ProductWorkspaceContainerEditorPanel"
                                        AutomationProperties.AutomationId="ProductWorkspaceContainerEditorPanel"
                                        Spacing="8">
                                        <ComboBox
                                            x:Name="ProductWorkspaceContainerEditSelector"
                                            AutomationProperties.AutomationId="ProductWorkspaceContainerEditSelector"
                                            AutomationProperties.Name="选择要重命名的正式方格"
                                            DisplayMemberPath="DisplayName"
                                            Header="已有方格"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="ProductWorkspaceContainerEditSelector_SelectionChanged" />
                                        <TextBox
                                            x:Name="ProductWorkspaceContainerNameEditor"
                                            AutomationProperties.AutomationId="ProductWorkspaceContainerNameEditor"
                                            AutomationProperties.Name="正式方格名称"
                                            Header="方格名称"
                                            MaxLength="256"
                                            PlaceholderText="输入方格名称"
                                            TextChanged="ProductWorkspaceContainerNameEditor_TextChanged" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceContainerNameGuidance"
                                            AutomationProperties.AutomationId="ProductWorkspaceContainerNameGuidance"
                                            AutomationProperties.ItemStatus="WorkspaceContainerNameIntentUnavailable:CanCreate=False:CanRename=False:Changed=False:DesktopFilesChanged=False"
                                            FontSize="11"
                                            Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                            Text="等待可编辑的正式工作区。"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ProductWorkspaceContainerCreateButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerCreateButton"
                                                AutomationProperties.Name="创建并保存正式方格"
                                                Click="ProductWorkspaceContainerCreateButton_Click"
                                                Content="创建并保存"
                                                IsEnabled="False" />
                                            <Button
                                                x:Name="ProductWorkspaceContainerRenameButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerRenameButton"
                                                AutomationProperties.Name="重命名并保存所选正式方格"
                                                Click="ProductWorkspaceContainerRenameButton_Click"
                                                Content="重命名并保存"
                                                IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ProductWorkspaceContainerLockButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerLockButton"
                                                AutomationProperties.Name="切换所选正式方格锁定状态并保存"
                                                Click="ProductWorkspaceContainerLockButton_Click"
                                                Content="锁定并保存"
                                                IsEnabled="False" />
                                            <Button
                                                x:Name="ProductWorkspaceContainerCollapseButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerCollapseButton"
                                                AutomationProperties.Name="切换所选正式方格折叠状态并保存"
                                                Click="ProductWorkspaceContainerCollapseButton_Click"
                                                Content="折叠并保存"
                                                IsEnabled="False" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="ProductWorkspaceContainerColorSelector"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerColorSelector"
                                                AutomationProperties.Name="选择正式方格颜色预设"
                                                DisplayMemberPath="DisplayName"
                                                Header="颜色预设"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="False"
                                                SelectionChanged="ProductWorkspaceContainerAppearanceSelector_SelectionChanged" />
                                            <ComboBox
                                                x:Name="ProductWorkspaceContainerOpacitySelector"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerOpacitySelector"
                                                AutomationProperties.Name="选择正式方格透明度预设"
                                                DisplayMemberPath="DisplayName"
                                                Header="透明度"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="False"
                                                SelectionChanged="ProductWorkspaceContainerAppearanceSelector_SelectionChanged" />
                                        </Grid>
                                        <Button
                                            x:Name="ProductWorkspaceContainerAppearanceButton"
                                            AutomationProperties.AutomationId="ProductWorkspaceContainerAppearanceButton"
                                            AutomationProperties.Name="应用所选正式方格外观预设并保存"
                                            Click="ProductWorkspaceContainerAppearanceButton_Click"
                                            Content="应用外观并保存"
                                            IsEnabled="False" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="ProductWorkspaceContainerPositionSelector"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerPositionSelector"
                                                AutomationProperties.Name="选择正式方格位置预设"
                                                DisplayMemberPath="DisplayName"
                                                Header="位置预设（DIP）"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="False"
                                                SelectionChanged="ProductWorkspaceContainerPlacementSelector_SelectionChanged" />
                                            <ComboBox
                                                x:Name="ProductWorkspaceContainerSizeSelector"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerSizeSelector"
                                                AutomationProperties.Name="选择正式方格尺寸预设"
                                                DisplayMemberPath="DisplayName"
                                                Header="尺寸预设（DIP）"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="False"
                                                SelectionChanged="ProductWorkspaceContainerPlacementSelector_SelectionChanged" />
                                        </Grid>
                                        <Button
                                            x:Name="ProductWorkspaceContainerPlacementButton"
                                            AutomationProperties.AutomationId="ProductWorkspaceContainerPlacementButton"
                                            AutomationProperties.Name="应用所选正式方格布局预设并保存"
                                            Click="ProductWorkspaceContainerPlacementButton_Click"
                                            Content="应用布局并保存"
                                            IsEnabled="False" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ProductWorkspaceContainerRemoveButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerRemoveButton"
                                                AutomationProperties.Name="删除所选正式方格配置但保留桌面文件"
                                                Click="ProductWorkspaceContainerRemoveButton_Click"
                                                Content="删除方格配置"
                                                IsEnabled="False" />
                                            <Button
                                                x:Name="ProductWorkspaceContainerRemovalUndoButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceContainerRemovalUndoButton"
                                                AutomationProperties.Name="撤销最近一次正式方格删除"
                                                Click="ProductWorkspaceContainerRemovalUndoButton_Click"
                                                Content="撤销删除方格"
                                                IsEnabled="False" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="把桌面项目加入所选方格" />
                                        <ListView
                                            x:Name="ProductWorkspaceResolvedReferenceSelector"
                                            AutomationProperties.AutomationId="ProductWorkspaceResolvedReferenceSelector"
                                            AutomationProperties.Name="多选要加入所选正式方格的桌面项目"
                                            DisplayMemberPath="DisplayName"
                                            MaxHeight="180"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            SelectionMode="Multiple"
                                            SelectionChanged="ProductWorkspaceResolvedReferenceSelector_SelectionChanged" />
                                        <Grid
                                            x:Name="ProductWorkspaceResolvedReferenceSelectionActionGrid"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button
                                                x:Name="ProductWorkspaceResolvedReferenceSelectFirstBatchButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceResolvedReferenceSelectFirstBatchButton"
                                                AutomationProperties.Name="选择未分组列表中的前256个项目"
                                                Click="ProductWorkspaceResolvedReferenceSelectFirstBatchButton_Click"
                                                Content="选择前 256 项"
                                                IsEnabled="False" />
                                            <Button
                                                x:Name="ProductWorkspaceResolvedReferenceClearSelectionButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceResolvedReferenceClearSelectionButton"
                                                AutomationProperties.Name="清除批量加入项目选择"
                                                Click="ProductWorkspaceResolvedReferenceClearSelectionButton_Click"
                                                Content="清除选择"
                                                Grid.Column="1"
                                                IsEnabled="False" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ProductWorkspaceResolvedReferenceAddButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceResolvedReferenceAddButton"
                                                AutomationProperties.Name="把所选桌面项目作为引用批量加入正式方格并保存"
                                                Click="ProductWorkspaceResolvedReferenceAddButton_Click"
                                                Content="选择项目后批量加入"
                                                IsEnabled="False" />
                                            <Button
                                                x:Name="ProductWorkspaceReferenceBatchAdditionUndoButton"
                                                AutomationProperties.AutomationId="ProductWorkspaceReferenceBatchAdditionUndoButton"
                                                AutomationProperties.Name="撤销最近一次批量加入引用"
                                                Click="ProductWorkspaceReferenceBatchAdditionUndoButton_Click"
                                                Content="撤销批量加入"
                                                IsEnabled="False" />
                                        </StackPanel>
