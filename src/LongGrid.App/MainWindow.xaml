<Window
    x:Class="LongGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LongGrid.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Long方格">

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource LongGridWindowBrush}"
        AutomationProperties.AccessibilityView="Content"
        AutomationProperties.AutomationId="LongGridRoot"
        AutomationProperties.ItemStatus="wide"
        AutomationProperties.Name="Long方格主界面">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="24"
                Height="24"
                Source="Assets/LongFangGe.png"
                AutomationProperties.Name="Long方格图标" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource LongGridTextPrimaryBrush}"
                Text="Long方格" />
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellNavigation"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="244"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <controls:ProductBrandHeader />
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AccessKey="1"
                    AutomationProperties.AutomationId="NavOverview"
                    Content="桌面概览"
                    Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="2"
                    AutomationProperties.AutomationId="NavBoxes"
                    Content="盒子管理"
                    Tag="boxes">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="3"
                    AutomationProperties.AutomationId="NavPersonalization"
                    Content="个性化"
                    Tag="personalization">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="NavSettings"
                    AccessKey="4"
                    AutomationProperties.AutomationId="NavSettings"
                    Content="设置"
                    Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ContentFrame" Padding="32,28,32,32">
                <ScrollViewer
                    AutomationProperties.AutomationId="ContentScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                        <StackPanel
                            x:Name="OverviewPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="OverviewPanel"
                            AutomationProperties.Name="概览内容"
                            Spacing="20">
                            <InfoBar
                                x:Name="ConfigurationRecoveryBanner"
                                AutomationProperties.ItemStatus="StartupReadOnly:Catalog=FirstLevelMetadata;DesktopFileWrites=Disabled;DesktopHost=Disconnected"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Informational"
                                Title="正在检查本地配置"
                                Message="配置与桌面目录采用只读启动；不会移动、重命名、删除或写入桌面文件，也不连接 DesktopHost 执行窗口操作。">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Name="ConfigurationRecoveryActionButton"
                                        AutomationProperties.AutomationId="ConfigurationRecoveryActionButton"
                                        AutomationProperties.Name="检查并接受已验证备份"
                                        Click="ConfigurationRecoveryActionButton_Click"
                                        Content="检查并接受备份"
                                        Visibility="Collapsed" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <controls:ProductPageHeader
                                x:Name="OverviewPageHeader"
                                AutomationProperties.AutomationId="OverviewPageHeader"
                                Title="桌面概览"
                                Subtitle="管理桌面盒子、文件夹绑定与最近操作。">
                                <controls:ProductPageHeader.ActionContent>
                                    <Button
                                        x:Name="OpenCreateBoxButton"
                                        AutomationProperties.AutomationId="OpenCreateBoxButton"
                                        AutomationProperties.Name="新建盒子"
                                        Click="OpenCreateBoxButton_Click"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="新建盒子" />
                                        </StackPanel>
                                    </Button>
                                </controls:ProductPageHeader.ActionContent>
                            </controls:ProductPageHeader>

                            <StackPanel
                                x:Name="ProductOverviewPanel"
                                AutomationProperties.AutomationId="ProductOverviewPanel"
                                Spacing="20">
                                <Grid x:Name="ProductOverviewMetricsGrid" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="OverviewBoxCountCard"
                                        AutomationProperties.AccessibilityView="Content"
                                        AutomationProperties.AutomationId="OverviewBoxCountCard"
                                        AutomationProperties.Name="桌面盒子数量"
                                        Style="{StaticResource LongGridCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="桌面盒子" />
                                            <TextBlock
                                                x:Name="OverviewBoxCountValue"
                                                AutomationProperties.AutomationId="OverviewBoxCountValue"
                                                FontSize="28"
                                                FontWeight="SemiBold"
                                                Text="—" />
                                            <TextBlock
                                                x:Name="OverviewBoxCountDetail"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="正在读取工作区"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="OverviewItemCountCard"
                                        Grid.Column="1"
                                        AutomationProperties.AccessibilityView="Content"
                                        AutomationProperties.AutomationId="OverviewItemCountCard"
                                        AutomationProperties.Name="盒子项目数量"
                                        Style="{StaticResource LongGridCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="盒子项目" />
                                            <TextBlock
                                                x:Name="OverviewItemCountValue"
                                                AutomationProperties.AutomationId="OverviewItemCountValue"
                                                FontSize="28"
                                                FontWeight="SemiBold"
                                                Text="—" />
                                            <TextBlock
                                                x:Name="OverviewItemCountDetail"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="等待真实数据"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="OverviewHealthCard"
                                        Grid.Column="2"
                                        AutomationProperties.AccessibilityView="Content"
                                        AutomationProperties.AutomationId="OverviewHealthCard"
                                        AutomationProperties.Name="工作区健康状态"
                                        Style="{StaticResource LongGridCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="当前状态" />
                                            <TextBlock
                                                x:Name="OverviewHealthValue"
                                                AutomationProperties.AutomationId="OverviewHealthValue"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Text="正在连接" />
                                            <TextBlock
                                                x:Name="OverviewHealthDetail"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="正在检查盒子与引用"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="OverviewBoxesCard"
                                    AutomationProperties.Name="我的盒子摘要"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="我的盒子" />
                                                <TextBlock
                                                    x:Name="OverviewBoxesSummary"
                                                    AutomationProperties.AutomationId="OverviewBoxesSummary"
                                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                                    Text="正在读取真实工作区"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="OpenBoxesManagementButton"
                                                AutomationProperties.Name="管理全部盒子"
                                                Click="OpenBoxesManagementButton_Click"
                                                Content="管理全部" />
                                        </Grid>
                                        <StackPanel
                                            x:Name="OverviewEmptyState"
                                            AutomationProperties.AutomationId="OverviewEmptyState"
                                            HorizontalAlignment="Center"
                                            Spacing="8"
                                            Visibility="Collapsed">
                                            <SymbolIcon HorizontalAlignment="Center" Symbol="Library" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Text="还没有桌面盒子" />
                                            <TextBlock
                                                MaxWidth="460"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="创建第一个盒子，开始整理桌面。"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Center"
                                                AutomationProperties.AutomationId="OverviewEmptyCreateButton"
                                                AutomationProperties.Name="创建第一个盒子"
                                                Click="OpenCreateBoxButton_Click"
                                                Content="创建盒子"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                        <ListView
                                            x:Name="OverviewContainerList"
                                            AutomationProperties.AutomationId="OverviewContainerList"
                                            AutomationProperties.Name="盒子摘要列表"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="52" Padding="4,6" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                                                Text="{Binding Detail}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource LongGridAccentSoftBrush}"
                                                            CornerRadius="8">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Health}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <Border
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="OverviewRecentActionCard"
                                    AutomationProperties.Name="最近操作"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon Margin="2,2,0,0" Symbol="Clock" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="最近操作" />
                                            <TextBlock
                                                x:Name="OverviewRecentActionDetail"
                                                AutomationProperties.AutomationId="OverviewRecentActionDetail"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="暂无可撤销的盒子操作"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            x:Name="OverviewLatestUndoButton"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="OverviewLatestUndoButton"
                                            AutomationProperties.Name="没有可撤销的盒子操作"
                                            Click="ProductWorkspaceLatestUndoButton_Click"
                                            Content="撤销"
                                            IsEnabled="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid x:Name="OverviewMetricsGrid" ColumnSpacing="14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="CurrentModeCard"
                                    Grid.Column="0"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="CurrentModeCard"
                                    AutomationProperties.Name="当前模式"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="当前模式" />
                                        <TextBlock x:Name="CurrentModeValue" AutomationProperties.AutomationId="CurrentModeValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CurrentModeDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="FileOperationCard"
                                    Grid.Column="1"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="FileOperationCard"
                                    AutomationProperties.Name="文件操作"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="文件操作" />
                                        <TextBlock x:Name="FileOperationValue" AutomationProperties.AutomationId="FileOperationValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="FileOperationDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="DesktopHostCard"
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="DesktopHostCard"
                                    AutomationProperties.Name="桌面宿主"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="桌面宿主" />
                                        <ToggleSwitch
                                            x:Name="BoxesEnabledToggle"
                                            AutomationProperties.AutomationId="BoxesEnabledToggle"
                                            AutomationProperties.Name="显示桌面方格"
                                            Header="显示桌面方格"
                                            IsEnabled="False"
                                            OffContent="已关闭"
                                            OnContent="已开启"
                                            Toggled="BoxesEnabledToggle_Toggled" />
                                        <TextBlock
                                            x:Name="BoxesEnabledStatus"
                                            AutomationProperties.AutomationId="BoxesEnabledStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在读取桌面方格设置…"
                                            TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            x:Name="ThumbnailsEnabledToggle"
                                            AutomationProperties.AutomationId="ThumbnailsEnabledToggle"
                                            AutomationProperties.Name="显示图片缩略图"
                                            Header="显示图片缩略图"
                                            IsEnabled="False"
                                            OffContent="类型图标"
                                            OnContent="图片预览"
                                            Toggled="ThumbnailsEnabledToggle_Toggled" />
                                        <TextBlock
                                            x:Name="ThumbnailsEnabledStatus"
                                            AutomationProperties.AutomationId="ThumbnailsEnabledStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在读取缩略图设置…"
                                            TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            x:Name="SingleClickOpenToggle"
                                            AutomationProperties.AutomationId="SingleClickOpenToggle"
                                            AutomationProperties.Name="单击打开桌面项目"
                                            Header="单击打开桌面项目"
                                            IsEnabled="False"
                                            OffContent="双击打开（推荐）"
                                            OnContent="单击打开"
                                            Toggled="SingleClickOpenToggle_Toggled" />
                                        <TextBlock
                                            x:Name="SingleClickOpenStatus"
                                            AutomationProperties.AutomationId="SingleClickOpenStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在读取打开方式设置…"
                                            TextWrapping="Wrap" />
                                        <TextBlock x:Name="DesktopHostValue" AutomationProperties.AutomationId="DesktopHostValue" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DesktopHostDetail" Style="{StaticResource LongGridSubtitleTextStyle}" />
                                        <Button
                                            x:Name="DesktopKeyboardInteractionButton"
                                            AccessKey="I"
                                            AutomationProperties.AutomationId="DesktopKeyboardInteractionButton"
                                            AutomationProperties.Name="进入桌面方格交互"
                                            Click="DesktopKeyboardInteractionButton_Click"
                                            Content="进入桌面交互 (_I)"
                                            IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                x:Name="ProductDesktopCatalogCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductDesktopCatalogCard"
                                AutomationProperties.Name="桌面内容状态"
                                Visibility="Collapsed"
                                Style="{StaticResource LongGridCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        x:Name="ProductDesktopCatalogIcon"
                                        Margin="2,2,0,0"
                                        Symbol="Folder" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogTitle"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogTitle"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="桌面目录尚未读取" />
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogDetail"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogDetail"
                                            AutomationProperties.ItemStatus="DesktopCatalogUnavailable:Generation=0:Items=0:Authoritative=False"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在连接桌面内容；Long方格不会自动移动或删除文件。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ProductDesktopCatalogGeneration"
                                            AutomationProperties.AutomationId="ProductDesktopCatalogGeneration"
                                            FontSize="11"
                                            Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                            Text="刷新代次 0 · 用户桌面 未读取 · 公共桌面 未读取" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ProductDesktopCatalogRefreshButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="ProductDesktopCatalogRefreshButton"
                                        AutomationProperties.Name="刷新只读桌面目录"
                                        Click="ProductDesktopCatalogRefreshButton_Click"
                                        Content="刷新目录" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceSessionCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceSessionCard"
                                AutomationProperties.Name="方格工作区状态"
                                Visibility="Collapsed"
                                Style="{StaticResource LongGridCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon
                                        x:Name="ProductWorkspaceSessionIcon"
                                        Margin="2,2,0,0"
                                        Symbol="Clock" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionTitle"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionTitle"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="正在建立产品会话" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionDetail"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionDetail"
                                            AutomationProperties.ItemStatus="WorkspaceSessionLoading:Source=None:Catalog=Unavailable:ReadOnly=True"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="正在安全读取正式配置；不会把空目录清单冒充当前桌面状态。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ProductWorkspaceSessionSummary"
                                            AutomationProperties.AutomationId="ProductWorkspaceSessionSummary"
                                            FontSize="11"
                                            Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                            Text="引用解析计数尚不可用" />
                                        <Button
                                            x:Name="ProductWorkspaceLatestUndoButton"
                                            AutomationProperties.AutomationId="ProductWorkspaceLatestUndoButton"
                                            AutomationProperties.ItemStatus="LatestWorkspaceEditUndo:Kind=Unavailable:CanUndo=False:DesktopFilesChanged=False:DesktopWindowsChanged=False"
                                            AutomationProperties.Name="没有可撤销的 Long方格配置编辑"
                                            Click="ProductWorkspaceLatestUndoButton_Click"
                                            Content="没有可撤销的配置编辑"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceLayoutRecoveryCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryCard"
                                AutomationProperties.Name="正式布局恢复只读预览"
                                Visibility="Collapsed"
                                Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoveryTitle"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="布局恢复预览尚不可用" />
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoveryDetail"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryDetail"
                                        AutomationProperties.ItemStatus="LayoutRecoveryPreviewUnavailableSession:Containers=0:Mappings=0:Unresolved=0:Corrected=0:DesktopWindowsChanged=False"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="等待正式产品会话；没有读取或移动任何桌面窗口。"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ProductWorkspaceLayoutRecoverySummary"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoverySummary"
                                        FontSize="11"
                                        Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                                        Text="容器与显示拓扑尚不可用" />
                                    <Button
                                        x:Name="ProductWorkspaceLayoutRecoveryConfirmButton"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryConfirmButton"
                                        AutomationProperties.Name="审查并确认配置级布局恢复"
                                        Click="ProductWorkspaceLayoutRecoveryConfirmButton_Click"
                                        Content="审查并确认配置恢复"
                                        IsEnabled="False"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="ProductWorkspaceLayoutRecoveryUndoButton"
                                        AutomationProperties.AutomationId="ProductWorkspaceLayoutRecoveryUndoButton"
                                        AutomationProperties.Name="撤销本次配置级布局恢复"
                                        Click="ProductWorkspaceLayoutRecoveryUndoButton_Click"
                                        Content="撤销本次配置恢复"
                                        IsEnabled="False"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ProductWorkspaceViewCard"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="ProductWorkspaceViewCard"
