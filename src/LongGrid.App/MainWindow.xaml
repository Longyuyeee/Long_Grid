                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="SafeReferenceModeCard"
                                        Grid.Column="0"
                                        Style="{StaticResource LongGridCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton
                                                    x:Name="SafeReferenceMode"
                                                    AutomationProperties.AutomationId="SafeReferenceMode"
                                                    AutomationProperties.HelpText="只创建 Long方格组织关系，不移动磁盘文件"
                                                    Checked="OrganizationMode_Checked"
                                                    Content="安全引用"
                                                    GroupName="OrganizationMode"
                                                    Tag="safe-reference" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="推荐" />
                                                </Border>
                                            </Grid>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="只改变 Long方格里的组织关系" />
                                            <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="原始文件不移动、不删除；原生桌面图标可能仍然存在。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="ManagedMoveModeCard"
                                        Grid.Column="1"
                                        Style="{StaticResource LongGridCardStyle}">
                                        <StackPanel Spacing="12">
                                            <RadioButton
                                                x:Name="ManagedMoveMode"
                                                AutomationProperties.AutomationId="ManagedMoveMode"
                                                AutomationProperties.HelpText="了解真实文件移动所需的源、目标、冲突与确认"
                                                Checked="OrganizationMode_Checked"
                                                Content="真实移动（未开放）"
                                                GroupName="OrganizationMode"
                                                Tag="managed-move" />
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="会改变磁盘上的文件位置" />
                                            <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="正式能力必须展示源、目标、冲突和撤销边界，并再次明确确认。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="将发生什么" />
                                    <TextBlock
                                        x:Name="OrganizationOutcomeTitle"
                                        AutomationProperties.AutomationId="OrganizationOutcomeTitle"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="OrganizationOutcomeDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="OrganizationPreviewButton"
                                        AutomationProperties.AutomationId="OrganizationPreviewButton"
                                        Click="OrganizationPreviewButton_Click"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        x:Name="OrganizationPreviewStatus"
                                        AutomationProperties.AutomationId="OrganizationPreviewStatus"
                                        AutomationProperties.ItemStatus="NotGenerated"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="尚未生成预览；尚未修改任何文件。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="练习创建第一个方格" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="这个练习只创建当前进程中的匿名容器关系；不读取桌面、不保存配置，也不移动或删除文件。"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="PracticeContainerName"
                                        AutomationProperties.AutomationId="PracticeContainerName"
                                        AutomationProperties.HelpText="最多 40 个字符；不会用作文件夹名称"
                                        Header="方格名称"
                                        MaxLength="40"
                                        Text="我的第一个方格" />
                                    <Button
                                        x:Name="CreatePracticeContainerButton"
                                        AutomationProperties.AutomationId="CreatePracticeContainerButton"
                                        Click="CreatePracticeContainerButton_Click"
                                        Content="创建匿名方格"
                                        HorizontalAlignment="Left" />
                                    <Border
                                        x:Name="PracticeContainerPreview"
                                        AutomationProperties.AutomationId="PracticeContainerPreview"
                                        AutomationProperties.Name="已创建的匿名方格预览"
                                        Padding="16"
                                        Background="{ThemeResource LongGridSurfaceMutedBrush}"
                                        CornerRadius="12"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                x:Name="PracticeContainerNameValue"
                                                AutomationProperties.AutomationId="PracticeContainerNameValue"
                                                FontSize="18"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="PracticeContainerCountValue"
                                                AutomationProperties.AutomationId="PracticeContainerCountValue"
                                                Style="{StaticResource LongGridSubtitleTextStyle}"
                                                Text="0 个匿名引用 · 仅内存" />
                                            <ListView
                                                x:Name="PracticeItemsList"
                                                AutomationProperties.AutomationId="PracticeItemsList"
                                                AutomationProperties.Name="匿名引用列表"
                                                IsItemClickEnabled="False"
                                                SelectionMode="None"
                                                Visibility="Collapsed">
                                                <ListViewItem
                                                    AutomationProperties.AutomationId="PracticeItemOne"
                                                    Content="匿名项目 A · 引用" />
                                                <ListViewItem
                                                    AutomationProperties.AutomationId="PracticeItemTwo"
                                                    Content="匿名项目 B · 引用" />
                                                <ListViewItem
                                                    AutomationProperties.AutomationId="PracticeItemThree"
                                                    Content="匿名项目 C · 引用" />
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="10">
                                        <Button
                                            x:Name="AddPracticeItemsButton"
                                            AutomationProperties.AutomationId="AddPracticeItemsButton"
                                            AutomationProperties.HelpText="向当前匿名方格添加三个内存引用；不会读取或移动文件"
                                            Click="AddPracticeItemsButton_Click"
                                            Content="添加 3 个匿名引用"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="UndoPracticeContainerButton"
                                            AutomationProperties.AutomationId="UndoPracticeContainerButton"
                                            AutomationProperties.HelpText="撤销当前进程中的容器关系；不会删除文件"
                                            Click="UndoPracticeContainerButton_Click"
                                            Content="撤销创建（Ctrl+Z）"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Z" Modifiers="Control" />
                                            </Button.KeyboardAccelerators>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="PracticeActivityStatus"
                                        AutomationProperties.AutomationId="PracticeActivityStatus"
                                        AutomationProperties.ItemStatus="PracticeContainerReady"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="可以开始练习；尚未创建关系，尚未修改任何文件。"
                                        TextWrapping="Wrap" />

                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="判断拖放会发生什么" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="这是非视觉语义练习，不接收 Explorer 数据。选择来源与目标，只查看动作徽标和安全后果。"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button
                                            x:Name="DropSafeReferenceButton"
                                            AutomationProperties.AutomationId="DropSafeReferenceButton"
                                            Click="DropPracticeButton_Click"
                                            Content="Explorer → 安全引用方格"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False"
                                            Tag="safe-reference" />
                                        <Button
                                            x:Name="DropReassignButton"
                                            AutomationProperties.AutomationId="DropReassignButton"
                                            Click="DropPracticeButton_Click"
                                            Content="方格引用 → 另一个方格"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False"
                                            Tag="reassign" />
                                        <Button
                                            x:Name="DropManagedMoveButton"
                                            AutomationProperties.AutomationId="DropManagedMoveButton"
                                            Click="DropPracticeButton_Click"
                                            Content="Explorer → 请求移动文件"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False"
                                            Tag="managed-move" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="DropActionStatus"
                                        AutomationProperties.AutomationId="DropActionStatus"
                                        AutomationProperties.ItemStatus="DropPracticeUnavailable"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="先创建匿名方格，再练习判断拖放语义。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="RecoveryPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="RecoveryPanel"
                            AutomationProperties.Name="匿名布局恢复差异原型"
                            Spacing="20"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="RECOVERY PREVIEW" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="先看差异，再决定如何恢复" />
                                <TextBlock
                                    MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                    Text="这是匿名、内存态的恢复差异练习。它复用 Core 的状态词汇，但不读取显示器、不创建快照，也不移动任何窗口或方格。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <InfoBar
                                AutomationProperties.AutomationId="RecoverySafetyBanner"
                                IsClosable="False"
                                IsOpen="True"
                                Severity="Success"
                                Title="当前布局保持不变"
                                Message="选择场景只生成匿名差异；确认按钮仅记录理解，不执行恢复。" />

                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择匿名规划结果" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="产品必须区分可自动恢复、需要确认和禁止应用，不能把相似映射包装成已识别同一显示器。"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button
                                            x:Name="RecoveryAutomaticScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryAutomaticScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="拓扑等价：Automatic"
                                            HorizontalAlignment="Left"
                                            Tag="automatic" />
                                        <Button
                                            x:Name="RecoveryReviewScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryReviewScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="需要可见性纠正：ReviewRequired"
                                            HorizontalAlignment="Left"
                                            Tag="review" />
                                        <Button
                                            x:Name="RecoveryBlockedScenarioButton"
                                            AutomationProperties.AutomationId="RecoveryBlockedScenarioButton"
                                            Click="RecoveryScenarioButton_Click"
                                            Content="映射缺失或歧义：Blocked"
                                            HorizontalAlignment="Left"
                                            Tag="blocked" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="RecoveryPlanStatus"
                                        AutomationProperties.AutomationId="RecoveryPlanStatus"
                                        AutomationProperties.ItemStatus="RecoveryPreviewReady"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="请选择场景；尚未生成恢复差异，尚未移动任何方格。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="RecoveryDiffPanel"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="RecoveryDiffPanel"
                                AutomationProperties.Name="匿名恢复差异"
                                Style="{StaticResource LongGridCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="12">
                                    <TextBlock
                                        x:Name="RecoverySummaryTitle"
                                        AutomationProperties.AutomationId="RecoverySummaryTitle"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="RecoveryDiffDetail"
                                        AutomationProperties.AutomationId="RecoveryDiffDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="RecoverySafetyDetail"
                                        AutomationProperties.AutomationId="RecoverySafetyDetail"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button
                                            x:Name="ReviewRecoveryButton"
                                            AutomationProperties.AutomationId="ReviewRecoveryButton"
                                            Click="ReviewRecoveryButton_Click"
                                            Content="确认理解（不执行）"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="ExpireRecoveryPreviewButton"
                                            AutomationProperties.AutomationId="ExpireRecoveryPreviewButton"
                                            Click="ExpireRecoveryPreviewButton_Click"
                                            Content="模拟显示再次变化"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="CancelRecoveryPreviewButton"
                                            AutomationProperties.AutomationId="CancelRecoveryPreviewButton"
                                            Click="CancelRecoveryPreviewButton_Click"
                                            Content="取消并保持当前布局"
                                            HorizontalAlignment="Left"
                                            IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="AppearancePanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="AppearancePanel"
                            AutomationProperties.Name="外观与 Token 内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="DESIGN SYSTEM" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="可复用 Token，而不是散落常量" />
                                <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="首片建立颜色、间距、圆角和卡片层级；控件状态继续复用 WinUI 系统资源。" />
                            </StackPanel>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="界面主题" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="切换只在当前进程内生效；本切片不写配置，也不改变 Windows 系统主题。" />
                                    <StackPanel x:Name="ThemeOptions" Orientation="Horizontal" Spacing="20">
                                        <RadioButton
                                            x:Name="ThemeSystem"
                                            AutomationProperties.AutomationId="ThemeSystem"
                                            Checked="ThemeOption_Checked"
                                            Content="跟随系统"
                                            GroupName="AppTheme"
                                            IsChecked="True"
                                            Tag="system" />
                                        <RadioButton
                                            x:Name="ThemeLight"
                                            AutomationProperties.AutomationId="ThemeLight"
                                            Checked="ThemeOption_Checked"
                                            Content="浅色"
                                            GroupName="AppTheme"
                                            Tag="light" />
                                        <RadioButton
                                            x:Name="ThemeDark"
                                            AutomationProperties.AutomationId="ThemeDark"
                                            Checked="ThemeOption_Checked"
                                            Content="深色"
                                            GroupName="AppTheme"
                                            Tag="dark" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ThemeStatusText"
                                        AutomationProperties.AutomationId="ThemeStatusText"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="当前：跟随系统（仅内存）" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="品牌与表面" />
                                    <Grid x:Name="BrandSurfaceGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BrandPrimarySurface" Grid.Column="0" Height="116" Background="{StaticResource LongGridBrandBrush}" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Foreground="White" FontWeight="SemiBold" Text="Brand · #5B5FF5" /></Border>
                                        <Border x:Name="BrandMutedSurface" Grid.Column="1" Height="116" Background="{ThemeResource LongGridSurfaceMutedBrush}" BorderBrush="{ThemeResource LongGridBorderBrush}" BorderThickness="1" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Text="Muted Surface" /></Border>
                                        <Border x:Name="BrandCardSurface" Grid.Column="2" Height="116" Background="{ThemeResource LongGridSurfaceBrush}" BorderBrush="{ThemeResource LongGridBorderBrush}" BorderThickness="1" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Text="Card Surface" /></Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="系统强调色继续承担选择、焦点和交互状态；品牌靛蓝不作为唯一状态线索。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="SafetyPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="SafetyPanel"
                            AutomationProperties.Name="安全边界内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="SAFETY CONTRACT" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="当前切片主动不做什么" />
                                <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="功能边界直接展示在界面中，避免把技术骨架误认成已经可用的桌面整理产品。" />
                            </StackPanel>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <InfoBar IsClosable="False" IsOpen="True" Severity="Success" Title="真实桌面保持不变" Message="没有目录枚举、Shell 通知、文件移动、删除、规则执行或自动配置写入。" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="受限配置导入" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="仅从你明确选择的本地 .json 文件生成有限预览；确认前不写入，导入不会扫描桌面或移动文件。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ImportConfigurationButton"
                                            AutomationProperties.AutomationId="ImportConfigurationButton"
                                            AutomationProperties.Name="选择并检查本地配置"
                                            Click="ImportConfigurationButton_Click"
                                            Content="选择配置…" />
                                        <TextBlock
                                            x:Name="ConfigurationImportStatus"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ConfigurationImportStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未选择配置。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="安全导出" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="先生成有限预览并确认，再由你选择本地文件夹；导出内容包含配置中保存的引用目标，使用唯一文件名，不覆盖既有文件，也不修改 Long方格配置存储。"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ExportConfigurationButton"
                                            AutomationProperties.AutomationId="ExportConfigurationButton"
                                            AutomationProperties.Name="预览并导出已验证配置"
                                            Click="ExportConfigurationButton_Click"
                                            Content="导出配置…" />
                                        <TextBlock
                                            x:Name="ConfigurationExportStatus"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ConfigurationExportStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未准备导出。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="配置证据清单" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="仅显示 Long方格归档证据的匿名类型、角色、大小和时间；不读取内容或显示路径。阈值未批准前不自动清理；永久清理只作用于明确选择的一条。"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="RefreshConfigurationEvidenceButton"
                                            AutomationProperties.AutomationId="RefreshConfigurationEvidenceButton"
                                            AutomationProperties.Name="刷新配置证据清单"
                                            Click="RefreshConfigurationEvidenceButton_Click"
                                            Content="刷新证据" />
                                        <TextBlock
                                            x:Name="ConfigurationEvidenceStatus"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ConfigurationEvidenceStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LongGridSubtitleTextStyle}"
                                            Text="尚未读取证据元数据。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <ListView
                                        x:Name="ConfigurationEvidenceList"
                                        AutomationProperties.AutomationId="ConfigurationEvidenceList"
                                        AutomationProperties.Name="配置证据匿名清单"
                                        MaxHeight="220"
                                        SelectionChanged="ConfigurationEvidenceList_SelectionChanged"
                                        SelectionMode="Single" />
                                    <Button
                                        x:Name="ExportConfigurationEvidenceButton"
                                        AutomationProperties.AutomationId="ExportConfigurationEvidenceButton"
                                        AutomationProperties.Name="导出所选原始配置证据"
                                        Click="ExportConfigurationEvidenceButton_Click"
                                        Content="导出所选证据…"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                                    <Button
                                        x:Name="RemoveConfigurationEvidenceButton"
                                        AutomationProperties.AutomationId="RemoveConfigurationEvidenceButton"
                                        AutomationProperties.Name="永久清理所选配置证据"
                                        Click="RemoveConfigurationEvidenceButton_Click"
                                        Content="清理所选证据…"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="仍需关闭的产品门槛" />
                                    <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="• Issue #19–#24 实机与负责人决策&#x0a;• ADR-0001 最终 Go / Revise / No-Go&#x0a;• UI Automation、Narrator、高对比和 DPI 实机矩阵&#x0a;• 真实产品状态保存、DesktopHost 与正式渲染接线" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
