<Window
    x:Class="LongGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Long方格">

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource LongGridWindowBrush}"
        AutomationProperties.AccessibilityView="Content"
        AutomationProperties.AutomationId="LongGridRoot"
        AutomationProperties.ItemStatus="wide"
        AutomationProperties.Name="Long方格主界面">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="24"
                Height="24"
                Source="Assets/LongFangGe.png"
                AutomationProperties.Name="Long方格图标" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource LongGridTextPrimaryBrush}"
                Text="Long方格" />
            <Border
                x:Name="DevelopmentBadge"
                Grid.Column="2"
                Margin="14,0,0,0"
                Padding="8,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource LongGridSurfaceMutedBrush}"
                CornerRadius="8">
                <TextBlock
                    x:Name="DevelopmentBadgeText"
                    AutomationProperties.AutomationId="ResponsiveStatusText"
                    FontSize="11"
                    Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                    Text="开发期 · 只读 UI Shell" />
            </Border>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellNavigation"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="244"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AccessKey="1"
                    AutomationProperties.AutomationId="NavOverview"
                    Content="概览"
                    Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="2"
                    AutomationProperties.AutomationId="NavAppearance"
                    Content="外观与 Token"
                    Tag="appearance">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AccessKey="3"
                    AutomationProperties.AutomationId="NavSafety"
                    Content="安全边界"
                    Tag="safety">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentFrame" Padding="32,28,32,32">
                <ScrollViewer
                    AutomationProperties.AutomationId="ContentScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                        <StackPanel
                            x:Name="OverviewPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="OverviewPanel"
                            AutomationProperties.Name="概览内容"
                            Spacing="20">
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Severity="Informational"
                                Title="安全只读原型"
                                Message="当前界面不扫描真实桌面、不移动文件，也不连接 DesktopHost。" />
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="DESKTOP WORKSPACE" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="把桌面还给专注本身" />
                                <TextBlock
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource LongGridSubtitleTextStyle}"
                                    Text="这是 Long方格正式视觉语言的第一个开发切片：安静的表面、清晰的层级和明确的安全状态。下方内容均为匿名示例数据。" />
                            </StackPanel>

                            <Grid x:Name="OverviewMetricsGrid" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="CurrentModeCard"
                                    Grid.Column="0"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="CurrentModeCard"
                                    AutomationProperties.Name="当前模式"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="当前模式" />
                                        <TextBlock AutomationProperties.AutomationId="CurrentModeValue" FontSize="22" FontWeight="SemiBold" Text="只读 UI Shell" />
                                        <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="无桌面数据连接" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="FileOperationCard"
                                    Grid.Column="1"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="FileOperationCard"
                                    AutomationProperties.Name="文件操作"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="文件操作" />
                                        <TextBlock AutomationProperties.AutomationId="FileOperationValue" FontSize="22" FontWeight="SemiBold" Text="完全关闭" />
                                        <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="没有移动或删除入口" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="DesktopHostCard"
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="DesktopHostCard"
                                    AutomationProperties.Name="桌面宿主"
                                    Style="{StaticResource LongGridCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="桌面宿主" />
                                        <TextBlock AutomationProperties.AutomationId="DesktopHostValue" FontSize="22" FontWeight="SemiBold" Text="尚未接线" />
                                        <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="不影响 Explorer" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="示例工作区" />
                                            <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="仅用于验证容器层级、间距和小尺寸图标。" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Padding="10,5"
                                            Background="{ThemeResource LongGridSurfaceMutedBrush}"
                                            CornerRadius="10">
                                            <TextBlock FontSize="12" Text="4 个匿名引用" />
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="WorkspaceItemsGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="WorkspaceItemProject" Grid.Column="0" Padding="14" Background="{ThemeResource LongGridSurfaceMutedBrush}" CornerRadius="12"><TextBlock Text="项目 A" /></Border>
                                        <Border x:Name="WorkspaceItemReference" Grid.Column="1" Padding="14" Background="{ThemeResource LongGridSurfaceMutedBrush}" CornerRadius="12"><TextBlock Text="资料" /></Border>
                                        <Border x:Name="WorkspaceItemPending" Grid.Column="2" Padding="14" Background="{ThemeResource LongGridSurfaceMutedBrush}" CornerRadius="12"><TextBlock Text="待处理" /></Border>
                                        <Border x:Name="WorkspaceItemArchive" Grid.Column="3" Padding="14" Background="{ThemeResource LongGridSurfaceMutedBrush}" CornerRadius="12"><TextBlock Text="归档引用" /></Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="AppearancePanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="AppearancePanel"
                            AutomationProperties.Name="外观与 Token 内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="DESIGN SYSTEM" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="可复用 Token，而不是散落常量" />
                                <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="首片建立颜色、间距、圆角和卡片层级；控件状态继续复用 WinUI 系统资源。" />
                            </StackPanel>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="界面主题" />
                                    <TextBlock
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="切换只在当前进程内生效；本切片不写配置，也不改变 Windows 系统主题。" />
                                    <StackPanel x:Name="ThemeOptions" Orientation="Horizontal" Spacing="20">
                                        <RadioButton
                                            x:Name="ThemeSystem"
                                            AutomationProperties.AutomationId="ThemeSystem"
                                            Checked="ThemeOption_Checked"
                                            Content="跟随系统"
                                            GroupName="AppTheme"
                                            IsChecked="True"
                                            Tag="system" />
                                        <RadioButton
                                            x:Name="ThemeLight"
                                            AutomationProperties.AutomationId="ThemeLight"
                                            Checked="ThemeOption_Checked"
                                            Content="浅色"
                                            GroupName="AppTheme"
                                            Tag="light" />
                                        <RadioButton
                                            x:Name="ThemeDark"
                                            AutomationProperties.AutomationId="ThemeDark"
                                            Checked="ThemeOption_Checked"
                                            Content="深色"
                                            GroupName="AppTheme"
                                            Tag="dark" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ThemeStatusText"
                                        AutomationProperties.AutomationId="ThemeStatusText"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource LongGridSubtitleTextStyle}"
                                        Text="当前：跟随系统（仅内存）" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="品牌与表面" />
                                    <Grid x:Name="BrandSurfaceGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BrandPrimarySurface" Grid.Column="0" Height="116" Background="{StaticResource LongGridBrandBrush}" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Foreground="White" FontWeight="SemiBold" Text="Brand · #5B5FF5" /></Border>
                                        <Border x:Name="BrandMutedSurface" Grid.Column="1" Height="116" Background="{ThemeResource LongGridSurfaceMutedBrush}" BorderBrush="{ThemeResource LongGridBorderBrush}" BorderThickness="1" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Text="Muted Surface" /></Border>
                                        <Border x:Name="BrandCardSurface" Grid.Column="2" Height="116" Background="{ThemeResource LongGridSurfaceBrush}" BorderBrush="{ThemeResource LongGridBorderBrush}" BorderThickness="1" CornerRadius="16"><TextBlock Margin="16" VerticalAlignment="Bottom" Text="Card Surface" /></Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="系统强调色继续承担选择、焦点和交互状态；品牌靛蓝不作为唯一状态线索。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="SafetyPanel"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.AutomationId="SafetyPanel"
                            AutomationProperties.Name="安全边界内容"
                            Spacing="20"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LongGridEyebrowTextStyle}" Text="SAFETY CONTRACT" />
                                <TextBlock Style="{StaticResource LongGridTitleTextStyle}" Text="当前切片主动不做什么" />
                                <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="功能边界直接展示在界面中，避免把技术骨架误认成已经可用的桌面整理产品。" />
                            </StackPanel>
                            <Border Style="{StaticResource LongGridCardStyle}">
                                <StackPanel Spacing="14">
                                    <InfoBar IsClosable="False" IsOpen="True" Severity="Success" Title="真实桌面保持不变" Message="没有目录枚举、Shell 通知、文件移动、删除、规则执行或配置写入。" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="仍需关闭的产品门槛" />
                                    <TextBlock Style="{StaticResource LongGridSubtitleTextStyle}" Text="• Issue #19–#24 实机与负责人决策&#x0a;• ADR-0001 最终 Go / Revise / No-Go&#x0a;• UI Automation、Narrator、高对比和 DPI 实机矩阵&#x0a;• 单实例、配置排空、DesktopHost 与正式渲染接线" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
