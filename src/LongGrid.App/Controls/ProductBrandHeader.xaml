<UserControl
    x:Class="LongGrid.App.Controls.ProductBrandHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Height="72"
        Padding="12,10"
        AutomationProperties.AccessibilityView="Content"
        AutomationProperties.Name="Long方格 Desktop Studio">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            Background="{StaticResource LongGridBrandBrush}"
            CornerRadius="12">
            <Image
                Width="32"
                Height="32"
                Source="/Assets/LongFangGe.png"
                AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <StackPanel
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource LongGridTextPrimaryBrush}"
                Text="Long方格" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource LongGridTextSecondaryBrush}"
                Text="Desktop Studio" />
        </StackPanel>
    </Grid>
</UserControl>
